# Required canonical browser origin. Plain HTTP is allowed only for loopback.
APP_ORIGIN=http://127.0.0.1:3000
ENABLE_EXTERNAL_ENRICHMENT=false
# Set distinct least-privileged connections. No DATABASE_URL or localhost fallback.
# Use exactly one of NAME or NAME_FILE for every secret. Never commit runtime values.
AUTH_DATABASE_URL_FILE=/run/secrets/auth_database_url
READ_DATABASE_URL_FILE=/run/secrets/read_database_url
REPUTATION_DATABASE_URL_FILE=/run/secrets/reputation_database_url
# Optional: not mounted/enabled by default.
# MAINTENANCE_DATABASE_URL_FILE=/run/secrets/maintenance_database_url
# ABUSEIPDB_API_KEY_FILE=/run/secrets/abuseipdb_api_key
# Operator only (never pass provisioning/migration credentials to the app):
# MIGRATION_DATABASE_URL_FILE=/run/secrets/migration_database_url
# PROVISION_DATABASE_URL_FILE=/protected/operator/provision-database-url
# ROLE_PASSWORDS_FILE=.runtime/secrets/role-passwords.json
